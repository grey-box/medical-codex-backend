### Get Available Languages - Successful
GET https://backend.asu2024.azure.project-codex.grey-box.ca//languages/

> {%
    client.assert(response.status === 200, "Response status is not 200");
    client.assert(response.contentType.mimeType === "application/json", "Response content type is not application/json");
    const responseBody = JSON.parse(response.body);
    client.assert(responseBody.available_languages !== undefined && Array.isArray(responseBody.available_languages), "Response should contain 'available_languages' array");
