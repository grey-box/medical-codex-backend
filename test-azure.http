### Fuzzy Matching - Successful (en -> uk)
POST https://backend.asu2024.azure.project-codex.grey-box.ca//fuzzymatching/
Content-Type: application/json

{
  "source_language": "en",
  "query": "paracetamol",
  "target_language": "uk"
}

> {%
    client.assert(response.status === 201, "Response status is not 201");
    client.assert(response.contentType.mimeType === "application/json", "Response content type is not application/json");
    const responseBody = JSON.parse(response.body);
    client.assert(responseBody.results !== undefined && Array.isArray(responseBody.results), "Response should contain a 'results' array");
    if (responseBody.results && responseBody.results.length > 0) {
        client.assert(responseBody.results[0].matching_name !== undefined, "First result should have 'matching_name'");
        client.assert(responseBody.results[0].matching_source !== undefined, "First result should have 'matching_source'");
    }
%}

